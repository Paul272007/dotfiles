#!/usr/bin/env bash
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

echo "[pre-commit] 1/3 Checking staged changes for secrets..."
if command -v gitleaks >/dev/null 2>&1; then
  gitleaks protect --staged --redact --verbose
else
  echo "[pre-commit] WARNING: gitleaks not found, skipping secret scan." >&2
fi

echo "[pre-commit] 2/3 Testing GNU Stow in an isolated temporary directory..."
if command -v stow >/dev/null 2>&1; then
  TMP_HOME="$(mktemp -d)"
  trap 'rm -rf "$TMP_HOME"' EXIT
  stow -d "$ROOT" -t "$TMP_HOME" --no-folding .
  stow -D -d "$ROOT" -t "$TMP_HOME" --no-folding .
else
  echo "[pre-commit] ERROR: stow is required." >&2
  exit 1
fi

echo "[pre-commit] 3/3 Checking shell syntax..."
if command -v zsh >/dev/null 2>&1; then
  zsh -n "$ROOT/.zshrc"
  for f in "$ROOT"/.config/rc/*; do
    [ -f "$f" ] && zsh -n "$f"
  done
fi

if command -v bash >/dev/null 2>&1; then
  bash -n "$ROOT/.bashrc" "$ROOT/.local/bin/get-color"
  for f in "$ROOT"/.config/hypr/scripts/*.sh; do
    [ -f "$f" ] && bash -n "$f"
  done
fi

echo "[pre-commit] All checks passed."
