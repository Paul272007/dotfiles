#!/usr/bin/zsh

# ----------------------------------------------- #
# ----------- Completion rules for ZSH ---------- #
# ----------------------------------------------- #


# Initialize completion system
# -U : ignore user aliases
# -z : force ZSH function style
autoload -Uz compinit
compinit

# Load GNU dircolors configuration if available and export LS_COLORS
if (( $+commands[gdircolors] )); then
  eval "$(gdircolors -b)"
elif (( $+commands[dircolors] )); then
  eval "$(dircolors -b)"
fi
# Use LS_COLORS in Zsh completion menu
zstyle ':completion:*:default' list-colors ${(s.:.)LS_COLORS}

# Completion algorithms tried in order on Tab:
#  _expand      : expand variables and global aliases
#  _complete    : standard completion
#  _correct     : fix minor typos if nothing matches
#  _approximate : tolerate multiple typos
zstyle ':completion:*' completer _expand _complete _correct _approximate
# Matching rules:
# 1. ''                        : exact match first
# 2. 'm:{a-z}={A-Z}'           : lowercase matches uppercase
# 3. 'm:{a-zA-Z}={A-Za-z}'     : bidirectional case-insensitive match
# 4. 'r:|[._-]=* r:|=* l:|=*'  : partial matching across separators (_, ., -)
zstyle ':completion:*' matcher-list '' 'm:{a-z}={A-Z}' 'm:{a-zA-Z}={A-Za-z}' 'r:|[._-]=* r:|=* l:|=*'

# Show detailed descriptions alongside CLI option flags
zstyle ':completion:*' verbose true
# Header displayed above each completion category (%d = files, commands, aliases, etc.)
zstyle ':completion:*' format 'Completing %d'
# Group completions by category name (required for the format header above)
zstyle ':completion:*' group-name ''
# Enable interactive keyboard selection menu when at least 2 candidates exist
zstyle ':completion:*' menu select=2

# Prompt shown at the bottom when suggestions exceed screen height (%p = scroll percentage)
zstyle ':completion:*' list-prompt %SAt %p: Hit TAB for more, or the character to insert%s
# Prompt shown while actively scrolling through a paginated selection menu
zstyle ':completion:*' select-prompt %SScrolling active: current selection at %p%s

# Highlight process PIDs in bold red (01;31) when completing `kill`
zstyle ':completion:*:*:kill:*:processes' list-colors '=(#b) #([0-9]#)*=0=01;31'
# List only current user's processes with readable columns for `kill <TAB>`
zstyle ':completion:*:kill:*' command 'ps -u $USER -o pid,%cpu,tty,cputime,cmd'

