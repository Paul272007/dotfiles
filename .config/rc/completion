#!/usr/bin/zsh

# ----------------------------------------------- #
# ----------- Completion rules for ZSH ---------- #
# ----------------------------------------------- #


# Initialize completion system
# -U : ignore user aliases
# -z : force ZSH function style
autoload -Uz compinit
compinit

# Lit la configuration GNU dircolors (souvent /etc/DIR_COLORS ou ~/.dircolors) et exporte la variable d'environnement LS_COLORS avec le code couleur par extension de fichier.
# Utilité : Très utile si tu veux que les fichiers dans la complétion aient les mêmes couleurs que la commande ls.
eval "$(dircolors -b)"
# Injecte les couleurs de $LS_COLORS dans le menu de complétion de Zsh en découpant la chaîne aux deux-points (:).
# Utilité : Très utile (fonctionne de pair avec dircolors).
zstyle ':completion:*:default' list-colors ${(s.:.)LS_COLORS}

# Définit la chaîne d'algorithmes tentés dans l'ordre lors de l'appui sur Tab :
#  _expand : étend les variables/alias globaux.
#  _complete : complétion normale standard.
#  _correct : tente de corriger une petite faute de frappe si rien ne matche.
#  _approximate : tolère plusieurs fautes de frappe.
# Utilité : Très utile, mais attention : _approximate peut parfois ralentir la complétion sur de gros dossiers ou corriger des commandes alors que tu ne voulais pas.
zstyle ':completion:*' completer _expand _complete _correct _approximate
# Définit les étapes de tolérance de frappe :
# 1. '' : essaie d'abord la correspondance exacte.
# 2. 'm:{a-z}={A-Z}' : tolère l'insensibilité à la casse (minuscule matche majuscule).
# 3. 'm:{a-zA-Z}={A-Za-z}' : insensible à la casse bidirectionnelle.
# 4. Complétion partielle sur les délimiteurs (_, ., -).
zstyle ':completion:*' matcher-list '' 'm:{a-z}={A-Z}' 'm:{a-zA-Z}={A-Za-z}' 'r:|[._-]=* r:|=* l:|=*' # Completion ignores case

# Affiche des explications détaillées à côté des options (par exemple la description d'un flag --help d'un outil CLI).
zstyle ':completion:*' verbose true
# Définit le titre affiché au-dessus de chaque catégorie de complétion (%d devient par exemple files, commands, aliases).
# Utilité : Esthétique / Utile. Permet de bien repérer ce qui est proposé.
zstyle ':completion:*' format 'Completing %d'
# Active le regroupement par catégorie avec leur nom respectif (nécessaire pour que le format défini au-dessus s'applique distinctement aux groupes).
# Utilité : Utile si tu gardes la ligne format.
zstyle ':completion:*' group-name ''
# Active le menu de sélection navigable au clavier dès qu'il y a au moins 2 choix possibles.
zstyle ':completion:*' menu select=2

# Message affiché en bas quand la liste de suggestions dépasse la hauteur de l'écran (mode pagination). %p affiche le pourcentage déroulé.
# Utilité : Utile si tu complètes souvent des dossiers contenant des centaines de fichiers.
zstyle ':completion:*' list-prompt %SAt %p: Hit TAB for more, or the character to insert%s
# Affiche un indicateur de position (%p en %) lorsque tu es en train de naviguer activement dans un menu de sélection paginé.
# Utilité : Pratique si le menu interactif déborde de l'écran.
zstyle ':completion:*' select-prompt %SScrolling active: current selection at %p%s

# Colore en rouge gras (01;31) le PID des processus lors de la complétion de la commande kill.
zstyle ':completion:*:*:kill:*:processes' list-colors '=(#b) #([0-9]#)*=0=01;31'
# Modifie la commande système utilisée pour lister les processus à tuer avec kill <TAB> en n'affichant que tes processus (-u $USER) avec des colonnes claires (PID, CPU, terminal, temps, commande).
# Utilité : Excellente. Beaucoup plus lisible que la sortie par défaut de Zsh.
zstyle ':completion:*:kill:*' command 'ps -u $USER -o pid,%cpu,tty,cputime,cmd'

