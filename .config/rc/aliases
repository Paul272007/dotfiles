#!/bin/bash

# Included in .zshrc and .bashrc
# The file sets up all aliases for common commands

# Directories actions
zd() {
  if [ $# -eq 0 ]; then
    builtin cd ~ && return
  elif [ -d "$1" ]; then
    builtin cd "$1" && return
  else
    z "$@" && printf "\U000F17A9 " && pwd || return
    # No need for an error message since z already prints one out
  fi
}

# cd now calls the function above
alias cd='zd'
alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'

# ls
alias l='eza --icons=always --classify --group-directories-first'
alias ls='eza --icons=always --hyperlink --git --classify --group-directories-first -lh'
alias ms='eza --icons=always --hyperlink --git --classify --group-directories-first -lh'
alias la='eza --icons=always --classify -lA --group-directories-first'
alias lt='eza --tree --level=2 --long --icons=always --git'

# Vital shortcuts for already existing commands
alias ff="fzf --preview 'bat --style=numbers --color=always {}'"
alias e='exit'
alias se='sudoedit'
alias c='clear'
alias lg='lazygit'
alias d='docker'
alias eden='ssh eden@100.88.35.114' # example of how you can use ssh quicker
alias ctl='sudo systemctl'
alias sql='sudo mysql -u root -p'
alias chmox='chmod +x'
alias g='git'
alias decompress='tar -xvf'
alias mr='rm'
alias cp='cp -r'
alias glog='git log --all --oneline --graph'
alias rs='source ~/.zshrc'
alias y='yazi'
alias a='tmux attach'
# aliases for package managers
alias apt-up='sudo apt update'
alias upgrade='sudo apt update && sudo apt upgrade'
alias apt-i='sudo apt install'
alias pac='sudo pacman -Syu'
