#!/usr/bin/zsh

# ---------------------------------------------- #
# - Vital shortcuts for the most used commands - #
# ---------------------------------------------- #

# cd
alias cd='z'
alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'

# ls
alias l='eza --icons=always --hyperlink --group-directories-first'
alias ls='l --git -lh'
alias sl='ls'
alias ms='ls'
alias sm='ls'
alias la='ls -A'
alias lt='ls --tree --level=2 --long'

# package managers
alias up='yay -Syu --noconfirm'
alias i='yay -S --noconfirm'
alias u='yay -R --noconfirm'
alias autoremove='sudo pacman -Rns $(pacman -Qtdq)'

# Other commands
alias mr='rm'
alias e='exit'
alias c='clear'
alias abs='realpath'
alias y='yazi'
alias d='docker'
alias lg='lazygit'
alias t='tmux'
alias a='tmux attach'
alias popup='tmux display-popup -b rounded -d "#{pane_current_path}" -w 80% -h 80% -E '
alias empty=': > '
alias cp='cp -r'
alias chmox='chmod +x'
alias ctl='sudo systemctl'
alias sql='sudo mysql -u root -p'
alias open='xdg-open &>/dev/null'
alias rs='source ~/.zshrc'
alias rsync++='rsync -avh --progress --delete --exclude-from=/home/paul/.config/rsync/exclude.txt'
alias eden='ssh eden@100.67.67.67'

alias -s c='$EDITOR'
alias -s cc='$EDITOR'
alias -s cpp='$EDITOR'
alias -s lua='$EDITOR'
alias -s js='$EDITOR'
alias -s ts='$EDITOR'
alias -s json='bat'
alias -s md='bat'

alias -g NE='2>/dev/null'
alias -g NO='&>/dev/null'
alias -g JQ=' | jq'
alias -g C=' | wl-copy'
alias -g CFLAGS='-Wall -Wextra -Wpedantic -Wshadow -Wformat=2 -Wnull-dereference -Wconversion -Wsign-conversion -Wdouble-promotion -Wuninitialized -Wunused-label -Wno-comment'
alias -g CXXFLAGS='-Wall -Wextra -Wpedantic -Wshadow -Wformat=2 -Wnull-dereference -Wconversion -Wsign-conversion -Wdouble-promotion -Wuninitialized -Wunused-label -Wno-comment -Wnon-virtual-dtor -Wold-style-cast -Woverloaded-virtual'
