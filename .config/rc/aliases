# ---------------------------------------------- #
# - Vital shortcuts for the most used commands - #
# ---------------------------------------------- #

# cd
alias cd='z'
alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'

# ls
alias l='eza --icons=always --hyperlink --group-directories-first'
alias ls='l --git -lh'
alias sl='ls'
alias ms='ls'
alias sm='ls'
alias la='ls -A'
alias lt='ls --tree --level=2 --long'

# ssh
alias eden='ssh eden@100.88.35.114'

# package managers
alias update='sudo apt update'
alias up='sudo apt update && sudo apt upgrade'
alias apti='sudo apt install'
alias i='yay -Syu'

# Other commands
alias mr='rm'
alias e='exit'
alias c='clear'
alias chmox='chmod +x'
alias y='yazi'
alias d='docker'
alias lg='lazygit'
alias t='tmux'
alias a='tmux attach'
alias cp='cp -r'
alias ctl='sudo systemctl'
alias sql='sudo mysql -u root -p'
alias open='xdg-open &>/dev/null'

if [ "$CURRENT_SHELL" = "zsh" ]; then
  alias rs='source ~/.zshrc'
elif [ "$CURRENT_SHELL" = "bash" ]; then
  alias rs='source ~/.bashrc'
fi

if [ "$CURRENT_SHELL" = "zsh" ]; then
  alias -s c='$EDITOR'
  alias -s cc='$EDITOR'
  alias -s cpp='$EDITOR'
  alias -s lua='$EDITOR'
  alias -s js='$EDITOR'
  alias -s ts='$EDITOR'
  alias -s json='bat'
  alias -s md='bat'

  alias -g NE='2>/dev/null'
  alias -g NO='&>/dev/null'
  alias -g JQ=' | jq'
  alias -g C=' | wl-copy'
fi
