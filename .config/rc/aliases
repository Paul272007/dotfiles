# ---------------------------------------------- #
# - Vital shortcuts for the most used commands - #
# ---------------------------------------------- #

# cd
alias cd='z'
alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'

# ls
alias l='eza --icons=always --hyperlink --group-directories-first'
alias ls='l --git -lh'
alias sl='ls'
alias ms='ls'
alias sm='ls'
alias la='ls -A'
alias lt='ls --tree --level=2 --long'

# ssh
alias eden='ssh eden@100.88.35.114'

# package managers
alias update='sudo apt update'
alias up='sudo apt update && sudo apt upgrade'
alias apti='sudo apt install'
alias i='yay -Syu'

# other native commands and shortcuts
alias mr='rm'
alias e='exit'
alias c='clear'
alias chmox='chmod +x'
alias cp='cp -r'
alias ctl='sudo systemctl'

if [ "$CURRENT_SHELL" = "zsh" ]; then
  alias rs='source ~/.zshrc'
elif [ "$CURRENT_SHELL" = "bash" ]; then
  alias rs='source ~/.bashrc'
fi

# Other tools
alias y='yazi'
alias d='docker'
alias lg='lazygit'
alias a='tmux attach'
alias sql='sudo mysql -u root -p'
alias open='xdg-open &>/dev/null'
