#!/usr/bin/zsh

# ---------------------------------------------- #
# - Vital shortcuts for the most used commands - #
# ---------------------------------------------- #

# cd
alias cd='z'
alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'

# ls
alias l='eza --icons=always --hyperlink --group-directories-first'
alias ls='l --git -lh'
alias sl='ls'
alias ms='ls'
alias sm='ls'
alias la='ls -A'
alias al='la'
alias lt='ls --tree --level=2 --long'
alias tl='lt'

# package managers
alias up='yay -Syu --noconfirm'
alias i='yay -S --noconfirm'
alias u='yay -R --noconfirm'
alias autoremove='sudo pacman -Rns $(pacman -Qtdq)'
alias bsearch='brew formulae | fzf --preview "brew info {} 2>/dev/null || echo No package selected" --layout=reverse | xargs -r brew install'
alias casks='brew casks | fzf --preview "brew info {} 2>/dev/null || echo No package selected" --layout=reverse | xargs -r brew install --cask'

# Other commands
alias mr='rm'
alias rf='rm -rf'
alias e='exit'
alias c='clear'
alias abs='realpath'
alias y='yazi'
alias d='docker'
alias lg='lazygit'
alias t='tmux'
alias a='tmux attach'
alias popup='tmux display-popup -b rounded -d "#{pane_current_path}" -w 80% -h 80% -E '
alias empty=': > '
alias cp='cp -r'
alias chmox='chmod +x'
alias ctl='sudo systemctl'
alias sql='sudo mysql -u root -p'
alias rs='source ~/.zshrc'
alias rsync++='rsync -avh --modify-window=1 --no-perms --delete --exclude-from="$HOME/.config/rsync/exclude.txt"'
alias b='cmake --build build'
alias run-tests='ctest --test-dir build --output-on-failure'
alias cmake-debug='cmake --preset debug -B build'
alias cmake-release='cmake --preset release -B build'

alias -s c='$EDITOR'
alias -s cc='$EDITOR'
alias -s cpp='$EDITOR'
alias -s lua='$EDITOR'
alias -s js='$EDITOR'
alias -s ts='$EDITOR'
alias -s json='bat'
alias -s md='bat'

alias -g NE='2>/dev/null'
alias -g NO='&>/dev/null'
alias -g JQ='|& jq'
alias -g C='|& pbcopy'
alias -g S='| rg'
alias -g CFLAGS='-Wall -Wextra -Wpedantic -Wshadow -Wformat=2 -Wnull-dereference -Wconversion -Wsign-conversion -Wdouble-promotion -Wuninitialized -Wunused-label -Wno-comment'
alias -g CXXFLAGS='-Wall -Wextra -Wpedantic -Wshadow -Wformat=2 -Wnull-dereference -Wconversion -Wsign-conversion -Wdouble-promotion -Wuninitialized -Wunused-label -Wno-comment -Wnon-virtual-dtor -Wold-style-cast -Woverloaded-virtual'

# Decide which alias not to expand
GLOBALIAS_FILTER_VALUES=("l" "ls")
