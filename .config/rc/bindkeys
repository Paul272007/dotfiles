# ----------------------------------------------- #
# ------------- Keybindings for ZSH ------------- #
# ----------------------------------------------- #

if [ "$CURRENT_SHELL" = "zsh" ]; then
  # Use emacs keybindings even if $EDITOR is set to nvim
  bindkey -e

  # Quick edit using Alt+E
  bindkey -s '\ee' 'edit\n'
  # Go to project using Alt+G
  bindkey -s '\eg' 'pj\n'
  # Go to directory using Alt+C
  bindkey -s '\ec' 'cdtv\n'
  # Launch app using Alt+N
  bindkey -s '\en' 'npm run dev\n'
  # Launch docker compose using Alt+D
  bindkey -s '\ed' 'docker compose up -d\n'
  # Write sudo pacman -S instantly using Alt+P
  bindkey -s '\ep' 'sudo pacman -S '

  # Key bindings
  bindkey '^[[3~' delete-char
  bindkey '^[[1;5C' forward-word
  bindkey '^[[1;5D' backward-word
  bindkey '^[[3;5~' kill-word
  bindkey '^H' backward-kill-word
fi
