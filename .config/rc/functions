#!/bin/bash

# ----------------------------------------------- #
# ----- Additionnal functions for the shell ----- #
# ----------------------------------------------- #

# mkdir + cd
mk() {
  mkdir -p "$1" && cd "$1" || return
}

# Open files quietly
open() {
  xdg-open "$@" &>/dev/null
}

# Edit files quickly
edit() {
  local file="$1"
  local dir

  # When no argument, use television to choose file to edit
  if [ -z "$file" ]; then
    file=$(tv files)
    # Exit if esc was pressed
    [ -z "$file" ] && return 0
  fi

  # Check writing permissions
  dir=$(dirname "$file")
  # If the file can be written or if doesn't exist but the folder can be written
  if [ -w "$file" ] || { [ ! -e "$file" ] && [ -w "$dir" ]; }; then
    nvim "$file"
  else
    echo "Using sudoedit..."
    sudoedit "$file"
  fi
}

# Enable PHP server quickly
apacheup() {
  sudo systemctl start mariadb
  sudo systemctl start apache2
}

# Disable PHP server quickly
apachedown() {
  sudo systemctl stop apache2
  sudo systemctl stop mariadb
}

# Compression
compress() {
  tar -czf "${1%/}.tar.gz" "${1%/}"
}

# Switch between repos (tv git-repos somehow doesn't work)
pj() {
  local dir
  dir=$(tv git-repos)

  if [[ -n "$dir" ]]; then
    cd "$dir" || return
  fi
}

# cd to directory using television
cdtv() {
  local dir
  dir=$(tv dirs)

  if [[ -n "$dir" ]]; then
    cd "$dir" || return
  fi
}
