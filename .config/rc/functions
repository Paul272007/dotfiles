#!/usr/bin/zsh

# ----------------------------------------------- #
# ----- Additionnal functions for the shell ----- #
# ----------------------------------------------- #

# mkdir + cd
mk() {
  mkdir -p "$1" && cd "$1" || return
}

# Copy file content
x() {
  if [ -z "$1" ]; then
    return 1
  fi
  if [ ! -f "$1" ]; then
    return 2
  fi
  cat "$@" | wl-copy
}

# Edit files quickly
n() {
  local file="$1"
  local dir

  # When no argument, use television to choose file to edit
  if [ -z "$file" ]; then
    file=$(tv files)
    # Exit if esc was pressed
    [ -z "$file" ] && return 0
  fi

  # Check writing permissions
  dir=$(dirname "$file")
  # If the file can be written or if doesn't exist but the folder can be written
  if [ -w "$file" ] || { [ ! -e "$file" ] && [ -w "$dir" ]; }; then
    nvim "$file"
  else
    echo "Using sudoedit..."
    sudoedit "$file"
  fi
}

# Compression
compress() {
  tar -czf "${1%/}.tar.gz" "${1%/}"
}

# Switch between repos (tv git-repos somehow doesn't work)
pj() {
  local dir
  dir=$(tv git-repos)

  if [[ -n "$dir" ]]; then
    cd "$dir" || return
  fi
}

# cd to directory using television
cdtv() {
  local dir
  dir=$(tv dirs)

  if [[ -n "$dir" ]]; then
    cd "$dir" || return
  fi
}

# Sync files in ~ with USB stick
sync-usb() {
  local dry_run=()
  if [[ "$1" == "-n" || "$1" == "--dry" || "$1" == "--dry-run" ]]; then
    dry_run=(-n)
    shift
  fi
  if [[ -z "$1" ]]; then
    echo "Usage: sync-usb [-n|--dry-run] <dossier_destination>" >&2
    return 1
  fi

  local usb_root="$1"
  if [[ ! -d "$usb_root" ]]; then
    echo "Error: directory '$usb_root' does not exist" >&2
    return 2
  fi
  # Without / after ~ it would create subdirectory
  rsync -avh --progress --delete \
    "${dry_run[@]}" \
    --exclude-from=~/.config/rsync/exclude.txt \
    ~/ "$usb_root"
}

# Run each time that we cd somewhere
chpwd() {
  eza --icons=always --hyperlink --group-directories-first
  if [[ -f .nvmrc ]]; then
    nvm use
  fi
}
