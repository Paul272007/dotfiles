#!/bin/bash

# Included in .zshrc and .bashrc
# This file declares additional functions for the shell

mk() {
  mkdir -p "$1" && cd "$1" || return
}

open() {
  xdg-open "$@" >/dev/null
}

n() {
  if [ "$#" -eq 0 ]; then
    nvim .
  else
    nvim "$@"
  fi
}

# When you don't know if you have permissions or not
edit() {
  if [ -z "$1" ]; then
    # If no argument was given, search for file to edit with fzf
    nvim "$(fzf --preview='batcat {}')"
  else
    # Else use sudoedit if root privileges are needed
    local dir
    dir=$(dirname "$1")
    if [ -w "$1" ] || [ ! -e "$1" ] && [ -w "$dir" ]; then
      n "$@"
    else
      sudoedit "$@"
    fi
  fi
}

# Compression
compress() {
  tar -czf "${1%/}.tar.gz" "${1%/}"
}

