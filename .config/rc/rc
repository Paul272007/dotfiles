# ----------------------------------------------- #
# --------- Unified shell configuration --------- #
# ----------------------------------------------- #

# Can be sourced in either ~/.bashrc or ~/.zshrc

RC_DIR="$HOME/.config/rc"

source_if_exists() {
  if [ -f "$1" ]; then
    source "$1"
  else
    echo "Error: file $1 does not exist"
  fi
}

source_if_exists "$RC_DIR/envs"
source_if_exists "$RC_DIR/options"
source_if_exists "$RC_DIR/functions"
source_if_exists "$RC_DIR/plugins"
source_if_exists "$RC_DIR/completion"
source_if_exists "$RC_DIR/init"
source_if_exists "$RC_DIR/aliases"
source_if_exists "$RC_DIR/keybinds"

##### (Optionnal) Fastfetch

# If terminal is interactive
if [[ -t 1 ]]; then
  MIN_COLS=100
  MIN_LINES=35

  # Fetches the current size of the terminal
  TERM_COLS=$(tput cols 2>/dev/null || echo 0)
  TERM_LINES=$(tput lines 2>/dev/null || echo 0)

  # Compares current size to minimum
  if [ "$TERM_COLS" -ge "$MIN_COLS" ] && [ "$TERM_LINES" -ge "$MIN_LINES" ]; then
    fastfetch
  fi
fi
