#!/usr/bin/zsh

# ----------------------------------------------- #
# ---------------- Shell options ---------------- #
# ----------------------------------------------- #

HISTSIZE=3000
SAVEHIST=3000
HISTFILE=~/.zsh_history
HISTDUP=erase

# Removes slash and dot from characters considered as part of a word
WORDCHARS=${WORDCHARS//[\/.;]/}

# Set tab width to 2
tabs -2

# Zsh options
setopt share_history append_history
setopt hist_ignore_all_dups hist_ignore_space hist_save_no_dups hist_ignore_dups hist_find_no_dups
setopt hist_reduce_blanks
