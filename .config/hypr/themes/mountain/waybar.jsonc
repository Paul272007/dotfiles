{
  "position": "top",
  "exclusive": true,
  "gtk-layer-shell": true,
  "margin-top": 5,
  "margin-left": 15,
  "margin-right": 10,
  "height": 10,
  "modules-left": ["custom/weather", "cpu", "memory", "disk", "custom/updates"],
  "modules-center": ["hyprland/workspaces"],
  "modules-right": [
    "custom/redshift",
    "pulseaudio#speaker",
    "pulseaudio#microphone",
    "clock",
    "separator",
    "network",
    "bluetooth",
    "custom/power",
  ],

  "tray": {
    "icon-size": 16,
    "icon-theme": "Papirus",
    "spacing": 2,
  },
  "custom/spacer": {
    "format": " ",
    "tooltip": false,
  },
  "separator": {
    "format": " | ",
  },
  "hyprland/window": {
    "format": "{}",
    "max-length": 35,
    "rewrite": {
      "": "Harsh",
    },
    "separate-outputs": true,
  },
  "hyprland/workspaces": {
    "format": "{icon}",
    "on-click": "activate",
    "format-icons": {
      "1": "",
      "2": "",
      "3": "",
      "4": "",
      "5": "",
      "6": "",
      "7": "",
      "8": "",
      "9": "",
      "active": "",
      "urgent": "",
      "persistent": "",
      "focused": "",
      "default": "",
    },
    "sort-by-number": true,
    "persistent-workspaces": {
      "*": 9,
      "DP-1": 9,
    },
  },
  "custom/weather": {
    "exec": "~/.config/hypr/scripts/weather.sh",
    "return-type": "json",
    "interval": 600,
    "format": "{text}",
  },
  "cpu": {
    "format": "<span color='#F87C63' size='115%'>󰍛</span> <span color='#cdd6f4'>{usage}%</span>",
    "interval": 1,
    "format-alt-click": "click",
    "format-alt": "<span color='#00FF00'>{icon0}{icon1}{icon2}{icon3}</span> <span color='#FFFFFF'>{usage:>2}%</span> <span color='#00FF00'>󰍛</span>",
    "format-icons": ["▁", "▂", "▃", "▄", "▅", "▆", "▇", "█"],
    "on-click": "gnome-system-monitor",
  },
  "memory": {
    "interval": 3,
    "format": "<span color='#F87C63'> </span> <span color='#cdd6f4'>{used:0.1f}G</span>",
  },
  "disk": {
    "interval": 3,
    "path": "/home",
    "format": "<span color='#F87C63'> </span><span color='#cdd6f4'>{free}</span>",
    "unit": "GB",
  },
  "custom/updates": {
    "format": "{}",
    "return-type": "json",
    "exec": "~/.config/waybar/scripts/check_updates.sh",
    "interval": 1800,
    "on-click": "~/.config/waybar/scripts/run_updates.sh",
    "signal": 9,
    "tooltip": true,
  },
  "custom/redshift": {
    "format": "{}",
    "return-type": "json",
    "interval": 1,
    "exec": "~/.config/waybar/scripts/toggle_shade.sh status",
    "on-click": "~/.config/waybar/scripts/toggle_shade.sh",
    "signal": 8,
  },
  "pulseaudio#speaker": {
    "format": "<span color='#F87C63'>{icon} </span><span color='#cdd6f4'>{volume}%</span>",
    "format-bluetooth": "<span color='#a6e3a1'>{icon}</span>  <span color='#cdd6f4'>{volume}%</span>",
    "tooltip": false,
    "format-muted": "<span color='#F87C63'>󰝟</span>",
    "on-click": "wpctl set-mute @DEFAULT_SINK@ toggle",
    "on-scroll-up": "wpctl set-volume @DEFAULT_SINK@ 10%+",
    "on-scroll-down": "wpctl set-volume @DEFAULT_SINK@ 10%-",
    "format-icons": {
      "headphone": "",
      "hands-free": "",
      "headset": "",
      "phone": "",
      "portable": "",
      "car": "",
      "default": ["", "", ""],
    },
  },
  "pulseaudio#microphone": {
    "format": "{format_source}",
    "format-source": "<span color='#F87C63'> </span><span color='#cdd6f4'>{volume}%</span>",
    "format-source-muted": "<span color='#F87C63'>  </span>Off",
    "on-click": "wpctl set-mute @DEFAULT_SOURCE@ toggle",
    "on-scroll-up": "wpctl set-volume @DEFAULT_SOURCE@ 5%+",
    "on-scroll-down": "wpctl set-volume @DEFAULT_SOURCE@ 5%-",
  },
  "clock": {
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
    "format": "<span color='#F87C63'>󰥔 </span><span color='#cdd6f4'>{:%H:%M | %a %d %b}</span>",
    "format-alt": "<span color='#F87C63'>  </span>{:%Y-%m-%d}",
  },
  "network": {
    "format-wifi": "<span color='#F87C63'> </span> <span color='#cdd6f4'>{essid}</span>",
    "format-ethernet": "<span color='#F87C63'>󰈀 </span> <span color='#cdd6f4'>Câblé</span>",
    "format-disconnected": "<span color='#F87C63'>󰖪 </span> <span color='#cdd6f4'>Off</span>",
    "on-click": "nm-connection-editor",
  },
  "bluetooth": {
    "format-on": "<span size='110%' color='#F87C63'></span> <span color='#cdd6f4'>ON</span>",
    "format-off": "<span size='110%' color='#F87C63'>󰂲</span> <span color='#cdd6f4'>OFF</span>",
    "format-disabled": "<span size='110%' color='#F87C63'>󰂲</span> <span color='#cdd6f4'>OFF</span>",
    "format-connected": "<span size='110%' color='#F87C63'></span> <span color='#cdd6f4'>{device_alias}</span>",
    "on-click": "blueman-manager",
  },
  "custom/power": {
    "format": "<span color='#F87C63'>⏻ </span>",
    "tooltip": false,
    "on-click": "~/.config/rofi/powermenu.sh",
  },
}
