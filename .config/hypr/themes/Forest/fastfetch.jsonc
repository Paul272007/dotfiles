{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "type": "auto",
    "source": "",
    "color": {
      "1": "",
      "2": "",
      "3": "",
      "4": "",
      "5": "",
      "6": "",
      "7": "",
      "8": "",
      "9": "",
    },
    "width": null,
    "height": null,
    "padding": {
      "top": 4,
      "left": 7,
      "right": 9,
    },
    "printRemaining": true,
    "preserveAspectRatio": false,
    "cache": true,
    "position": "left",
    "chafa": {
      "fgOnly": false,
      "symbols": "block+border+space-wide-inverted",
    },
  },
  "display": {
    "stat": false,
    "pipe": false,
    "showErrors": false,
    "disableLinewrap": true,
    "hideCursor": false,
    "separator": " ",
    "color": {
      "keys": "white",
      "title": "white",
      "output": "white",
      "separator": "",
    },
    "brightColor": true,
    "duration": {
      "abbreviation": false,
      "spaceBeforeUnit": "default",
    },
    "size": {
      "maxPrefix": "YB",
      "binaryPrefix": "iec",
      "ndigits": 2,
      "spaceBeforeUnit": "default",
    },
    "temp": {
      "unit": "D",
      "ndigits": 1,
      "color": {
        "green": "32",
        "yellow": "93",
        "red": "91",
      },
      "spaceBeforeUnit": "default",
    },
    "percent": {
      "type": ["num", "num-color"],
      "ndigits": 0,
      "color": {
        "green": "32",
        "yellow": "93",
        "red": "91",
      },
      "spaceBeforeUnit": "default",
      "width": 0,
    },
    "bar": {
      "char": {
        "elapsed": "■",
        "total": "-",
      },
      "border": {
        "left": "[ ",
        "right": " ]",
        "leftElapsed": "",
        "rightElapsed": "",
      },
      "color": {
        "elapsed": "auto",
        "total": "97",
        "border": "97",
      },
      "width": 10,
    },
    "fraction": {
      "ndigits": 2,
    },
    "noBuffer": false,
    "key": {
      "width": 23,
      "type": "string",
      "paddingLeft": 0,
    },
    "freq": {
      "ndigits": 2,
      "spaceBeforeUnit": "default",
    },
    "constants": [],
  },
  "general": {
    "thread": true,
    "processingTimeout": 5000,
    "detectVersion": true,
    "playerName": "",
  },
  "modules": [
    {
      "type": "title",
      "key": "╭─   User                ",
      "keyColor": "red",
      "color": {
        "user": "white",
        "at": "white",
        "host": "white",
      },
    },
    {
      "type": "host",
      "key": "╰─ 󰌢  Host                ",
      "keyColor": "red",
    },
    "break",
    {
      "type": "os",
      "key": "╭─ 󰣇  OS                  ",
      "keyColor": "yellow",
    },
    {
      "type": "kernel",
      "key": "├─   Kernel              ",
      "keyColor": "yellow",
    },
    {
      "type": "uptime",
      "key": "├─   Uptime              ",
      "keyColor": "yellow",
    },
    {
      "type": "packages",
      "key": "├─ 󰏖  Packages            ",
      "disabled": ["apk"],
      "combined": false,
      "keyColor": "yellow",
    },
    {
      "type": "terminal",
      "key": "├─   Terminal            ",
      "keyColor": "yellow",
    },
    {
      "type": "shell",
      "key": "╰─   Shell               ",
      "keyColor": "yellow",
    },
    "break",
    {
      "type": "cpu",
      "key": "╭─   CPU                 ",
      "temp": false,
      "showPeCoreCount": false,
      "keyColor": "green",
    },
    {
      "type": "gpu",
      "key": "├─ 󰾲  GPU                 ",
      "driverSpecific": false,
      "detectionMethod": "pci",
      "temp": false,
      "hideType": "none",
      "percent": {
        "green": 50,
        "yellow": 80,
        "type": 0,
      },
      "keyColor": "green",
    },
    {
      "type": "display",
      "key": "├─ 󰍹  Display             ",
      "keyColor": "green",
      "compactType": "none",
      "preciseRefreshRate": false,
      "order": null,
    },
    {
      "type": "disk",
      "key": "├─   Disk                ",
      "keyColor": "green",
      "showRegular": true,
      "showExternal": true,
      "showHidden": false,
      "showSubvolumes": false,
      "showReadOnly": true,
      "showUnknown": false,
      "folders": "",
      "hideFolders": "/efi:/boot:/boot/*",
      "hideFS": "",
      "useAvailable": false,
      "percent": {
        "green": 50,
        "yellow": 80,
        "type": 0,
      },
    },
    {
      "type": "localip",
      "key": "├─ 󰩟  Local IP            ",
      "keyColor": "green",
      "showIpv4": true,
      "showIpv6": false,
      "showMac": false,
      "showLoop": false,
      "showPrefixLen": true,
      "showMtu": false,
      "showSpeed": false,
      "showFlags": false,
      "compact": false,
      "defaultRouteOnly": true,
      "showAllIps": false,
      "namePrefix": "",
    },
    {
      "type": "battery",
      "key": "├─   Battery             ",
      "keyColor": "green",
      "temp": false,
      "percent": {
        "green": 50,
        "yellow": 20,
        "type": 0,
      },
    },
    {
      "type": "swap",
      "key": "├─ 󰓡  Swap                ",
      "percent": {
        "green": 50,
        "yellow": 80,
        "type": 0,
      },
      "separate": false,
      "keyColor": "green",
    },
    {
      "type": "memory",
      "key": "╰─   Memory              ",
      "percent": {
        "green": 50,
        "yellow": 80,
        "type": 0,
      },
      "keyColor": "green",
    },
    "break",
    {
      "type": "wm",
      "key": "╭─   WM                  ",
      "keyColor": "cyan",
      "detectPlugin": true,
    },
    {
      "type": "wmtheme",
      "key": "├─ 󰓸  WM Theme            ",
      "keyColor": "cyan",
    },
    {
      "type": "de",
      "key": "├─   DE                  ",
      "keyColor": "cyan",
    },
    {
      "type": "theme",
      "key": "├─ 󰉼  Theme               ",
      "keyColor": "cyan",
    },
    {
      "type": "icons",
      "key": "├─   Icons               ",
      "keyColor": "cyan",
    },
    {
      "type": "cursor",
      "key": "├─ 󰆿  Cursor              ",
      "keyColor": "cyan",
    },
    {
      "type": "font",
      "key": "├─   Font                ",
      "keyColor": "cyan",
    },
    {
      "type": "terminalfont",
      "key": "├─   Terminal Font       ",
      "keyColor": "cyan",
    },
    // {
    //   "type": "locale",
    //   "key": "┃   Locale                 ┃",
    // },
    {
      "type": "colors",
      "key": "╰─   Colors              ",
      "keyColor": "cyan",
      "symbol": "circle",
      "paddingLeft": 0,
      "block": {
        "width": 3,
        "range": [0, 15],
      },
    },
  ],
}
