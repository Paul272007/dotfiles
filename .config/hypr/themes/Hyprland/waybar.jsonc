{
  "position": "top",
  "exclusive": true,
  "gtk-layer-shell": true,
  "margin-top": 5,
  "margin-left": 15,
  "margin-right": 10,
  "height": 10,
  "modules-left": [
    "custom/weather",
    "cpu",
    "memory",
    "disk",
    "battery",
    "custom/updates",
  ],
  "modules-center": ["hyprland/workspaces"],
  "modules-right": [
    "custom/hyprshade",
    "pulseaudio#speaker",
    "pulseaudio#microphone",
    "bluetooth",
    "network",
    "clock",
    "custom/power",
  ],

  "tray": {
    "icon-size": 16,
    "icon-theme": "Papirus",
    "spacing": 2,
  },
  "hyprland/window": {
    "format": "{}",
    "max-length": 35,
    "rewrite": {
      "": "Harsh",
    },
    "separate-outputs": true,
  },
  "hyprland/workspaces": {
    "format": "{icon}",
    "on-click": "activate",
    "format-icons": {
      "1": " ",
      "2": " ",
      "3": " ",
      "4": " ",
      "5": " ",
      "6": " ",
      "7": " ",
      "8": " ",
      "9": " ",
      "active": " ",
      "urgent": " ",
      "persistent": " ",
      "focused": " ",
      "default": " ",
    },
    "sort-by-number": true,
    "persistent-workspaces": {
      "*": 9,
      "DP-1": 9,
    },
  },
  "custom/weather": {
    "exec": "~/.config/hypr/scripts/weather.sh",
    "return-type": "json",
    "interval": 600,
    "format": "{text}",
  },
  "cpu": {
    "format": "<span color='#89b4fa' size='115%'>󰍛</span> {usage}%",
    "interval": 1,
    "format-alt-click": "click",
    "format-alt": "<span color='#00FF00'>{icon0}{icon1}{icon2}{icon3}</span> <span color='#FFFFFF'>{usage:>2}%</span> <span color='#00FF00'>󰍛</span>",
    "format-icons": ["▁", "▂", "▃", "▄", "▅", "▆", "▇", "█"],
    "on-click": "gnome-system-monitor",
  },
  "memory": {
    "interval": 3,
    "format": "<span color='#89b4fa'> </span> {used:0.1f}G",
  },
  "disk": {
    "interval": 3,
    "path": "/home",
    "format": "<span color='#89b4fa'> </span>{free}",
    "unit": "GB",
  },
  "battery": {
    "states": {
      "warning": 30,
      "critical": 15,
    },
    "format": "<span color='#89b4fa'>{icon}</span> {capacity}%",
    "format-charging": "<span color='#89b4fa'>󱐋</span> {capacity}%",
    "format-plugged": "<span color='#89b4fa'></span> {capacity}%",
    "format-alt": "{time} {icon}",
    "format-icons": ["", "", "", "", ""],
    "tooltip": true,
  },
  "custom/updates": {
    "format": "{}",
    "return-type": "json",
    "exec": "~/.config/hypr/scripts/check_updates.sh",
    "interval": 1800,
    "on-click": "~/.config/hypr/scripts/run_updates.sh",
    "signal": 9,
    "tooltip": true,
  },
  "custom/hyprshade": {
    "format": "{}",
    "return-type": "json",
    "interval": 1,
    "exec": "~/.config/hypr/scripts/toggle_shade.sh status",
    "on-click": "~/.config/hypr/scripts/toggle_shade.sh",
    "signal": 8,
  },
  "pulseaudio#speaker": {
    "format": "<span color='#89b4fa'>{icon}</span> {volume}%",
    "format-bluetooth": "<span color='#a6e3a1'>{icon}</span>  {volume}%",
    "tooltip": false,
    "format-muted": "<span color='#89b4fa'>󰝟</span>",
    "on-click": "wpctl set-mute @DEFAULT_SINK@ toggle",
    "on-scroll-up": "wpctl set-volume @DEFAULT_SINK@ 10%+",
    "on-scroll-down": "wpctl set-volume @DEFAULT_SINK@ 10%-",
    "format-icons": {
      "headphone": "",
      "hands-free": "",
      "headset": "",
      "phone": "",
      "portable": "",
      "car": "",
      "default": ["", "", ""],
    },
  },
  "pulseaudio#microphone": {
    "format": "{format_source}",
    "format-source": "<span color='#89b4fa'> </span>{volume}%",
    "format-source-muted": "<span color='#89b4fa'></span> OFF",
    "on-click": "wpctl set-mute @DEFAULT_SOURCE@ toggle",
    "on-scroll-up": "wpctl set-volume @DEFAULT_SOURCE@ 5%+",
    "on-scroll-down": "wpctl set-volume @DEFAULT_SOURCE@ 5%-",
  },
  "bluetooth": {
    "format-on": "<span size='110%' color='#89b4fa'></span> ON",
    "format-off": "<span size='110%' color='#89b4fa'>󰂲</span> OFF",
    "format-disabled": "<span size='110%' color='#89b4fa'>󰂲</span> OFF",
    "format-connected": "<span size='110%' color='#89b4fa'></span> {device_alias}",
    "on-click": "blueman-manager",
  },
  "network": {
    "format-wifi": "<span color='#89b4fa'> </span> {essid}",
    "format-ethernet": "<span color='#89b4fa'>󰈀 </span> Wired",
    "format-disconnected": "<span color='#89b4fa'>󰖪 </span> OFF",
    "on-click": "nm-connection-editor",
  },
  "clock": {
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
    "format": "<span color='#89b4fa'>󰥔 </span>{:%H:%M}",
    "format-alt": "<span color='#89b4fa'>  </span>{:%Y-%m-%d}",
  },
  "custom/power": {
    "format": "<span color='#89b4fa'> ⏻ </span>",
    "tooltip": false,
    "on-click": "~/.config/rofi/powermenu.sh",
  },
}
