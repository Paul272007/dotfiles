{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/dotfiles/.config/hypr/themes/hyprland/fastfetch.txt",
    "color": {
      "1": "cyan",
      "2": "",
      "3": "",
      "4": "",
      "5": "",
      "6": "",
      "7": "",
      "8": "",
      "9": "",
    },
    "width": null,
    "height": null,
    "padding": {
      "top": 0,
      "left": 0,
      "right": 1,
    },
    "printRemaining": true,
    "preserveAspectRatio": false,
    "recache": false,
    "position": "left",
    "chafa": {
      "fgOnly": false,
      "symbols": "block+border+space-wide-inverted",
    },
  },
  "display": {
    "stat": false,
    "pipe": false,
    "showErrors": false,
    "disableLinewrap": true,
    "hideCursor": false,
    "separator": " ",
    "color": {
      "keys": "cyan",
      "title": "cyan",
      "output": "cyan",
      "separator": "",
    },
    "brightColor": true,
    "duration": {
      "abbreviation": false,
      "spaceBeforeUnit": "default",
    },
    "size": {
      "maxPrefix": "YB",
      "binaryPrefix": "iec",
      "ndigits": 2,
      "spaceBeforeUnit": "default",
    },
    "temp": {
      "unit": "D",
      "ndigits": 1,
      "color": {
        "green": "32",
        "yellow": "93",
        "red": "91",
      },
      "spaceBeforeUnit": "default",
    },
    "percent": {
      "type": ["num", "num-color"],
      "ndigits": 0,
      "color": {
        "green": "32",
        "yellow": "93",
        "red": "91",
      },
      "spaceBeforeUnit": "default",
      "width": 0,
    },
    "bar": {
      "char": {
        "elapsed": "■",
        "total": "-",
      },
      "border": {
        "left": "[ ",
        "right": " ]",
        "leftElapsed": "",
        "rightElapsed": "",
      },
      "color": {
        "elapsed": "auto",
        "total": "97",
        "border": "97",
      },
      "width": 10,
    },
    "fraction": {
      "ndigits": 2,
    },
    "noBuffer": false,
    "key": {
      "width": 31,
      "type": "string",
      "paddingLeft": 0,
    },
    "freq": {
      "ndigits": 2,
      "spaceBeforeUnit": "default",
    },
    "constants": [],
  },
  "general": {
    "thread": true,
    "processingTimeout": 5000,
    "detectVersion": true,
    "playerName": "",
    "dsForceDrm": false,
  },
  "modules": [
    {
      "type": "custom",
      "format": "┏━━━━━━━━━━━━━━━━━━━━━━━━━━━┳━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓",
    },
    {
      "type": "title",
      "key": "┃   User                   ┃",
      "color": {
        "at": "cyan",
      },
    },
    {
      "type": "host",
      "key": "┃ 󰌢  Host                   ┃",
    },
    {
      "type": "custom",
      "format": "┗━━━━━━━━━━━━━━━━━━━━━━━━━━━┻━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛",
    },
    {
      "type": "custom",
      "format": "┏━━━━━━━━━━━━━━━━━━━━━━━━━━━┳━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓",
    },
    {
      "type": "os",
      "key": "┃ 󰣇  OS                     ┃",
    },
    {
      "type": "kernel",
      "key": "┃   Kernel                 ┃",
    },
    {
      "type": "uptime",
      "key": "┃   Uptime                 ┃",
    },
    {
      "type": "packages",
      "key": "┃ 󰏖  Packages               ┃",
      "disabled": ["apk"],
      "combined": false,
    },
    {
      "type": "terminal",
      "key": "┃   Terminal               ┃",
    },
    {
      "type": "shell",
      "key": "┃   Shell                  ┃",
    },
    {
      "type": "custom",
      "format": "┗━━━━━━━━━━━━━━━━━━━━━━━━━━━┻━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛",
    },
    {
      "type": "custom",
      "format": "┏━━━━━━━━━━━━━━━━━━━━━━━━━━━┳━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓",
    },
    {
      "type": "cpu",
      "key": "┃   CPU                    ┃",
      "temp": false,
      "showPeCoreCount": false,
    },
    {
      "type": "gpu",
      "key": "┃ 󰾲  GPU                    ┃",
      "driverSpecific": false,
      "detectionMethod": "pci",
      "temp": false,
      "hideType": "none",
      "percent": {
        "green": 50,
        "yellow": 80,
        "type": 0,
      },
    },
    {
      "type": "memory",
      "key": "┃   Memory                 ┃",
      "percent": {
        "green": 50,
        "yellow": 80,
        "type": 0,
      },
    },
    {
      "type": "swap",
      "key": "┃ 󰓡  Swap                   ┃",
      "percent": {
        "green": 50,
        "yellow": 80,
        "type": 0,
      },
      "separate": false,
    },
    {
      "type": "disk",
      "key": "┃   Disk                   ┃",
      "showRegular": true,
      "showExternal": true,
      "showHidden": false,
      "showSubvolumes": false,
      "showReadOnly": true,
      "showUnknown": false,
      "folders": "",
      "hideFolders": "/efi:/boot:/boot/*",
      "hideFS": "",
      "useAvailable": false,
      "percent": {
        "green": 50,
        "yellow": 80,
        "type": 0,
      },
    },
    {
      "type": "localip",
      "key": "┃ 󰩟  Local IP               ┃",
      "showIpv4": true,
      "showIpv6": false,
      "showMac": false,
      "showLoop": false,
      "showPrefixLen": true,
      "showMtu": false,
      "showSpeed": false,
      "showFlags": false,
      "compact": false,
      "defaultRouteOnly": true,
      "showAllIps": false,
      "namePrefix": "",
    },
    {
      "type": "battery",
      "key": "┃   Battery                ┃",
      "temp": false,
      "percent": {
        "green": 50,
        "yellow": 20,
        "type": 0,
      },
    },
    {
      "type": "poweradapter",
      "key": "┃ 󰚥  Power Adapter          ┃",
    },
    {
      "type": "display",
      "key": "┃ 󰍹  Display                ┃",
      "compactType": "none",
      "preciseRefreshRate": false,
      "order": null,
    },
    {
      "type": "custom",
      "format": "┗━━━━━━━━━━━━━━━━━━━━━━━━━━━┻━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛",
    },
    {
      "type": "custom",
      "format": "┏━━━━━━━━━━━━━━━━━━━━━━━━━━━┳━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓",
    },
    {
      "type": "de",
      "key": "┃   DE                     ┃",
    },
    {
      "type": "wm",
      "key": "┃   WM                     ┃",
      "detectPlugin": true,
    },
    {
      "type": "wmtheme",
      "key": "┃ 󰓸  WM Theme               ┃",
    },
    {
      "type": "theme",
      "key": "┃ 󰉼  Theme                  ┃",
    },
    {
      "type": "icons",
      "key": "┃   Icons                  ┃",
    },
    {
      "type": "cursor",
      "key": "┃ 󰆿  Cursor                 ┃",
    },
    {
      "type": "font",
      "key": "┃   Font                   ┃",
    },
    {
      "type": "terminalfont",
      "key": "┃   Terminal Font          ┃",
    },
    // {
    //   "type": "locale",
    //   "key": "┃   Locale                 ┃",
    // },
    {
      "type": "colors",
      "key": "┃   Colors                 ┃",
      "symbol": "circle",
      "paddingLeft": 0,
      "block": {
        "width": 3,
        "range": [0, 15],
      },
    },
    {
      "type": "custom",
      "format": "┗━━━━━━━━━━━━━━━━━━━━━━━━━━━┻━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛",
    },
  ],
}
