#!/bin/bash

# Included in .zshrc and .bashrc
# This file declares functions

mk() {
  mkdir -p "$1" && cd "$1" || return
}

open() {
  xdg-open "$@" >/dev/null 2>&1 &
}

n() {
  if [ "$#" -eq 0 ]; then
    nvim .
  else
    nvim "$@"
  fi
}

# When you don't know if you have permissions or not
edit() {
  local dir=$(dirname "$1")
  if [ -w "$1" ] || [ ! -e "$1" -a -w "$dir" ]; then
    n "$@"
  else
    sudoedit "$@"
  fi
}

# Compression
compress() {
  tar -czf "${1%/}.tar.gz" "${1%/}"
}

alias decompress='tar -xvf'

# Turn into jpeg
2jpg() {
  img="$1"
  shift
  magick "$img" $@ -quality 95 -strip ${img%.*}.jpg
}

# Turn into png
2png() {
  img="$1"
  shift
  magick "$img" $@ -strip -define png:compression-filter=5 \
    -define png:compression-level=9 \
    -define png:compression-strategy=1 \
    -define png:exclude-chunk=all \
    "${img%.*}.png"
}
