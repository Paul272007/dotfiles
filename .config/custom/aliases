#!/bin/bash

# Included in .zshrc and .bashrc
# The file sets up all aliases for the zsh or bash

# Directories actions
zd() {
  if [ $# -eq 0 ]; then
    builtin cd ~ && return
  elif [ -d "$1" ]; then
    builtin cd "$1"
  else
    z "$@" && printf "\U000F17A9 " && pwd || echo "Error: Directory not found"
  fi
}
alias cd='zd'
alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'

# ls
alias ls='eza --icons=auto --classify --group-directories-first -lh'
alias l='eza --icons --classify --group-directories-first'
alias la='eza --icons --classify -lA --group-directories-first'
alias lt='eza --tree --level=2 --long --icons --git'

