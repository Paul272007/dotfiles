# ~/dotfiles/.shell_config

# --- 1. Variables d'environnement ---
export EDITOR="nvim"
export VISUAL="nvim"
export TERM="xterm-256color"

# Configuration NVM
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"

# PATH : Ajout des binaires locaux et Neovim
export PATH="$HOME/.local/bin:$HOME/bin:$PATH"
export PATH="$PATH:/opt/nvim-linux-x86_64/bin"

# --- 2. Initialisation des outils (Cross-shell) ---

# Détection du shell courant pour les inits
CURRENT_SHELL=$(basename "$SHELL")

# Zoxide (remplace cd)
if command -v zoxide &> /dev/null; then
    eval "$(zoxide init "$CURRENT_SHELL")"
fi

# Starship (Prompt)
if command -v starship &> /dev/null; then
    eval "$(starship init "$CURRENT_SHELL")"
fi

# Try (Outil personnel)
if command -v try &> /dev/null; then
    eval "$(try init ~/test/labo)"
fi

# Homebrew (MacOS / Linux)
if [ -f "/home/linuxbrew/.linuxbrew/bin/brew" ]; then
    eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
elif [ -f "/opt/homebrew/bin/brew" ]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
fi

# --- 3. Alias ---
# Navigation
alias ..='cd ..'
alias ...='cd ../..'
alias ll='ls -alF --color=auto'
alias la='ls -A --color=auto'
alias l='ls -CF --color=auto'

# Outils
alias v='nvim'
alias vim='nvim'
alias g='git'
alias cat='bat --style=plain' # Si tu utilises bat, sinon retirer
alias grep='grep --color=auto'

# Gestion
alias update='sudo apt update && sudo apt upgrade' # Adapter selon distro
