#!/bin/bash

# 1. Read the current theme name
THEME=$(cat ~/.cache/current_theme 2>/dev/null || echo "Default")

# 2. Build the path to the accent color file
ACCENT_PATH="$HOME/.config/hypr/themes/$THEME/accent.txt"

# 3. Print the color (falling back to white if missing)
if [ -f "$ACCENT_PATH" ]; then
  # Strip whitespace and trailing newlines
  cat "$ACCENT_PATH" | tr -d '[:space:]'
else
  echo "#ffffff" # Default to white
fi
